{
  "name": "Gaming",
  "description": "Игры и лаунчеры напрямую, остальное через туннель",
  "default_action": { "proxy": "default" },
  "rules": [
    { "match": { "type": "ip", "cidr": "127.0.0.0/8" }, "action": "direct" },
    { "match": { "type": "ip", "cidr": "10.0.0.0/8" }, "action": "direct" },
    { "match": { "type": "ip", "cidr": "172.16.0.0/12" }, "action": "direct" },
    { "match": { "type": "ip", "cidr": "192.168.0.0/16" }, "action": "direct" },

    { "match": { "type": "port", "value": 3724 }, "action": "direct", "note": "WoW world" },
    { "match": { "type": "port", "value": 27015 }, "action": "direct", "note": "Steam" },
    { "match": { "type": "port", "value": 1119 }, "action": "direct", "note": "Battle.net" },

    { "match": { "type": "process", "name": "Wow.exe" }, "action": "direct" },
    { "match": { "type": "process", "name": "WowClassic.exe" }, "action": "direct" },
    { "match": { "type": "process", "name": "WowVoiceProxy.exe" }, "action": "direct" },
    { "match": { "type": "process", "name": "Battle.net.exe" }, "action": "direct" },
    { "match": { "type": "process", "name": "Agent.exe" }, "action": "direct" },
    { "match": { "type": "process", "name": "steam.exe" }, "action": "direct" },
    { "match": { "type": "process", "name": "steamwebhelper.exe" }, "action": "direct" },
    { "match": { "type": "process", "name": "EpicGamesLauncher.exe" }, "action": "direct" }
  ]
}
