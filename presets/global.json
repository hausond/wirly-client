{
  "name": "Global",
  "description": "Весь трафик через туннель, кроме локальной сети",
  "default_action": { "proxy": "default" },
  "rules": [
    { "match": { "type": "ip", "cidr": "127.0.0.0/8" }, "action": "direct", "note": "loopback" },
    { "match": { "type": "ip", "cidr": "10.0.0.0/8" }, "action": "direct", "note": "LAN" },
    { "match": { "type": "ip", "cidr": "172.16.0.0/12" }, "action": "direct", "note": "LAN" },
    { "match": { "type": "ip", "cidr": "192.168.0.0/16" }, "action": "direct", "note": "LAN" },
    { "match": { "type": "ip", "cidr": "169.254.0.0/16" }, "action": "direct", "note": "link-local" }
  ]
}
