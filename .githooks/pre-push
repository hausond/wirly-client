#!/bin/sh
# L1 gate: быстрые проверки перед пушем (< 3 минут).
set -e
cd "$(git rev-parse --show-toplevel)"
[ -d "$HOME/.cargo/bin" ] && PATH="$HOME/.cargo/bin:$PATH" && export PATH

# mingw-линкер не переносит кириллицу в пути — уводим target в ASCII.
if command -v cygpath >/dev/null 2>&1 && [ -n "$TEMP" ]; then
  CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$(cygpath -u "$TEMP")/vpn-target}"
else
  CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-${TMPDIR:-/tmp}/vpn-target}"
fi
export CARGO_TARGET_DIR

cargo fmt --all -- --check
cargo clippy --workspace --all-targets -- -D warnings
cargo test --workspace

echo "pre-push: ok"
