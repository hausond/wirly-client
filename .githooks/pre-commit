#!/bin/sh
# L0 gate: не пускаем мусор в историю.
set -e
cd "$(git rev-parse --show-toplevel)"
[ -d "$HOME/.cargo/bin" ] && PATH="$HOME/.cargo/bin:$PATH" && export PATH

staged_rs=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.rs$' || true)
if [ -n "$staged_rs" ]; then
  cargo fmt --all -- --check
fi

# секреты
if git diff --cached -U0 | grep -qE 'BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY'; then
  echo "pre-commit: похоже на приватный ключ в изменениях — коммит отклонён" >&2
  exit 1
fi

# слишком большие файлы
git diff --cached --name-only --diff-filter=ACM | while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(wc -c < "$f")
  if [ "$size" -gt 5242880 ]; then
    echo "pre-commit: файл больше 5 МБ: $f" >&2
    exit 1
  fi
done

# debug-макросы в библиотеках
if git diff --cached -U0 -- 'crates/**/*.rs' | grep -qE '^\+.*(dbg!|println!)'; then
  echo "pre-commit: dbg!/println! в библиотечном коде запрещены" >&2
  exit 1
fi

echo "pre-commit: ok"
